# Pouze veřejné údaje. Žádný API klíč ani jiné přihlašovací údaje.
VITE_CAL_USERNAME=adam-pruska
# Slug je poslední část skutečného odkazu cal.com/adam-pruska/NAZEV-UDALOSTI.
# Vyplňte až po ověření skutečných událostí a jejich délek.
VITE_CAL_INTRO_SLUG=nezavazna-konzultace
VITE_CAL_INDIVIDUAL_SLUG=soukroma-konzultace
# Balíček rezervuje první 50minutové setkání stejným typem; údaje o nabídce
# posílá v poznámce a metadatech. Další dvě konzultace se domlouvají samostatně.
VITE_CAL_PACKAGE_SLUG=soukroma-konzultace
