{
  "name": "consulting-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/build-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.cjs",
    "test:backend": "node scripts/check-backend.mjs",
    "test:admin": "node scripts/verify-admin.cjs",
    "deploy:backend": "node scripts/deploy-backend.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "html-validate": "^10.5.0",
    "playwright": "^1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
