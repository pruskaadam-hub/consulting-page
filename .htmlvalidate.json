{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "void-style": "off",
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "attribute-empty-style": [
      "error",
      {
        "style": "empty"
      }
    ],
    "attribute-boolean-style": [
      "error",
      {
        "style": "empty"
      }
    ],
    "no-trailing-whitespace": "off",
    "long-title": [
      "error",
      {
        "maxlength": 90
      }
    ]
  }
}
